rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Regras de Segurança - Salão de Beleza

    // Bloqueia tudo por padrão
    match /{document=**} {
      allow read, write: if false;
    }

    // Funções auxiliares
    function isSignedIn() {
      return request.auth != null;
    }

    // Configurações e Dados Públicos
    // Aberto para leitura pública, escrita apenas para admin autenticado
    match /configuracoes/{docId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /categorias/{docId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /produtos/{docId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /profissionais/{docId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /acompanhamentos/{docId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /anamnese_forms/{docId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /horarios_extras/{docId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Pedidos (Público pode criar, Admin gerencia)
    match /pedidos/{docId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isSignedIn();
    }

    // Lista de Espera (Público pode criar, Admin gerencia)
    match /waitlist/{docId} {
      allow create: if true;
      allow read, update, delete: if isSignedIn();
    }

    // Cancellation Requests (Público pode criar, Admin gerencia)
    match /cancellation_requests/{docId} {
      allow create: if true;
      allow read, update, delete: if isSignedIn();
    }

    // Histórico e Blacklist (Apenas Admin)
    match /clientes_historico/{docId} {
      allow read, write: if isSignedIn();
    }

    match /blacklist/{docId} {
      allow read, write: if isSignedIn();
    }
  }
}
